# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL via Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/insyta
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Redis (queue + pubsub + cache) ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# --- LLM providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
DEEPSEEK_API_KEY=sk-...

# --- Auth ---
JWT_SECRET=change-me-in-prod-use-32-char-random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Fernet key used to encrypt projects.webhook_secret_encrypted at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBHOOK_SECRET_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://insyta.io

# --- Observability ---
PHOENIX_ENDPOINT=http://localhost:6006
SENTRY_DSN=

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@insyta.io
